{
  "compilerOptions": {
    "lib": ["dom", "DOM.Iterable", "esnext"],
    "types": [],
    "jsx": "react-native",
    "target": "esnext",
    "moduleResolution": "bundler",
    "module": "esnext",
    "moduleDetection": "force",
    "esModuleInterop": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "skipLibCheck": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "rootDir": "./src",
    // `expo-arcgis` resolves to the core's workspace (packages/expo-arcgis) and its build/, which
    // the core's `prepare` writes during `npm ci` at the root. So this package builds on `prepack`
    // (or `npm run build`), not on install, where npm runs both packages' scripts at once.
    "outDir": "./build"
  },
  "include": ["./src"]
}
